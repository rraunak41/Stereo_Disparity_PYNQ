import cv2
from pynq import Overlay
from pynq.lib.video import *

print("Loading bitstream...")
ol = Overlay("./det.bit")

hdmi_out = ol.video.hdmi_out

# HDMI output
mode = VideoMode(1280, 720, 24)
hdmi_out.configure(mode, PIXEL_BGR)
hdmi_out.start()

print("Opening stereo camera...")
cap = cv2.VideoCapture(0)

cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

ret, test = cap.read()

if ret:
    print("Camera shape =", test.shape)
else:
    print("Camera failed!")
    raise RuntimeError("Camera not working")

print("Streaming...")

try:

    while True:

        ret, stereo = cap.read()

        if not ret:
            print("Camera read failed")
            break

        frame = hdmi_out.newframe()

        # Clear entire HDMI frame
        frame[:] = 0

        # Place stereo frame in center
        frame[120:600, :, :] = stereo

        hdmi_out.writeframe(frame)

except KeyboardInterrupt:
    print("Stopped")

finally:
    cap.release()
    hdmi_out.close()
